# DJ Dordje — Apache / Hostinger settings
ErrorDocument 404 /404.html
DirectoryIndex index.html

RewriteEngine On
# Force HTTPS and drop www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old WordPress URLs → new one-page site (keeps Google links and old shares working)
RewriteRule ^ru/?$ / [L,R=301]
RewriteRule ^en/?$ / [L,R=301]
RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [L,R=301]
RewriteRule ^feed/?$ / [L,R=301]

# Keep repo files off the public web
RedirectMatch 404 ^/(README\.md|\.git)

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 180 days"
  ExpiresByType image/jpeg "access plus 180 days"
  ExpiresByType video/mp4 "access plus 180 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
